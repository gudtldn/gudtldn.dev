{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Developer Profile Schema",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "domain": { "type": "string" },
    "status": {
      "anyOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "location": { "type": "string" },
    "timezone": { "type": "string", "description": "IANA 타임존 (예: Asia/Seoul)" },
    "timezoneAbbr": { "type": "string", "description": "표시용 약어 (예: KST)" },
    "blogUrl": { "type": "string" },
    "blogFeedUrl": { "type": "string", "description": "블로그 Atom/RSS 피드 주소. 지정하면 최신 글 5개를 표시 (브라우저에서 직접 가져오므로 CORS 허용 필요)" },
    "bio": { "type": "string", "description": "HTML 허용 (x-html로 렌더링됨). index.html의 정적 description/og:description과 함께 수정할 것" },
    "socials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": { "type": "string" },
          "url": { "type": "string" },
          "id": { "type": "string" }
        }
      }
    },
    "customLinks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "currentlyFocusing": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": { "type": "string" },
          "item": { "type": "string" }
        }
      }
    },
    "techStack": {
      "type": "object",
      "properties": {
        "languages": { "type": "array", "items": { "$ref": "#/definitions/badge" } },
        "tools": { "type": "array", "items": { "$ref": "#/definitions/badge" } }
      }
    },
    "projects": {
      "type": "array",
      "description": "포트폴리오 프로젝트. featured가 true인 항목이 먼저 표시됨. repo를 지정하면 GitHub에서 제목/설명/topics/마지막 push 시점을 가져오고, 여기에 적은 값이 우선함",
      "items": {
        "type": "object",
        "properties": {
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "description": "GitHub 저장소 (owner/name). 지정하면 title/summary/tags/status/links를 GitHub에서 채움" },
          "title": { "type": "string", "description": "생략 시 저장소 이름" },
          "summary": { "type": "string", "description": "한 줄 요약. 생략 시 저장소 description" },
          "description": { "type": "string", "description": "2~3줄 상세 설명" },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "생략 시 저장소 topics" },
          "image": { "type": "string", "description": "썸네일 경로 (예: projects/foo.png). 없으면 그라데이션 대체" },
          "status": { "type": "string", "description": "예: 진행 중, 완료. repo 지정 시 생략하면 마지막 push 기준으로 자동 표시" },
          "featured": { "type": "boolean" },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "enum": ["github", "demo", "blog", "video", "other"] },
                "label": { "type": "string", "description": "생략 시 type에 맞는 기본 라벨" },
                "url": { "type": "string" }
              },
              "required": ["url"]
            }
          }
        },
        "anyOf": [
          { "required": ["repo"] },
          { "required": ["title", "summary"] }
        ]
      }
    },
    "infrastructure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "theme": { "enum": ["orange", "emerald", "blue", "purple", "rose", "slate", "red", "green"] }
        }
      }
    },
    "github": {
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "themeColor": { "type": "string" }
      }
    }
  },
  "required": ["name", "domain", "bio"],
  "definitions": {
    "badge": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "logo": { "type": "string", "description": "skillicons.dev 아이콘 ID" },
        "url": { "type": "string" }
      },
      "required": ["name", "logo"]
    }
  }
}
